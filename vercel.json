{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/.well-known/security.txt",
      "destination": "/public/.well-known/security.txt"
    },
    {
      "source": "/favicon.ico",
      "destination": "https://college-o.onrender.com/favicon.ico"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://college-o.onrender.com/uploads/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://college-o.onrender.com/api/:path*"
    },
    {
      "source": "/contact",
      "destination": "/contact-us.html"
    },
    {
      "source": "/forms",
      "destination": "/create-support-request.html"
    },
    {
      "source": "/leaderboard",
      "destination": "/leaderboards.html"
    },
    {
      "source": "/membership",
      "destination": "/pricing.html"
    },
    {
      "source": "/mock-test",
      "destination": "/mock-tests.html"
    },
    {
      "source": "/notes",
      "destination": "/notes-library.html"
    },
    {
      "source": "/roadmap",
      "destination": "/study-roadmap.html"
    },
    {
      "source": "/contribute",
      "destination": "/academic-contribution-hub.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self \"https://meet.jit.si\"), microphone=(self \"https://meet.jit.si\"), geolocation=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://meet.jit.si https://download.agora.io https://accounts.google.com https://www.gstatic.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://college-o.onrender.com https://*.supabase.co wss://*.supabase.co https://meet.jit.si https://download.agora.io https://accounts.google.com https://oauth2.googleapis.com https://challenges.cloudflare.com; frame-src 'self' https://meet.jit.si https://challenges.cloudflare.com" }
      ]
    },
    {
      "source": "/(login|signup|admin-.*|dashboard|study|notes|mock-tests|mock-test|profile|settings|roadmap|ai-tools|live-hub|reset-password)(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}